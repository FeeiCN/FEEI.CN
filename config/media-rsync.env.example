# Copy this file to config/media-rsync.env and adjust the remote target.

# Local Docusaurus static media directory. The default is static/media in this repo.
# MEDIA_SYNC_LOCAL_DIR=/Users/feei/Projects/my-website/static/media

# Remote directory served as /media by the deployment release symlink.
MEDIA_SYNC_REMOTE=deploy@example.com:/data/wufeifei.com-site/shared/media

# two-way pulls newer remote files first, then pushes newer local files.
# Use pull or push when you intentionally want one-way sync.
MEDIA_SYNC_DIRECTION=two-way

# The launchd/systemd templates run the script periodically.
MEDIA_SYNC_INTERVAL=300

# Destructive deletion is intentionally limited to one-way pull/push.
# MEDIA_SYNC_DELETE=true
