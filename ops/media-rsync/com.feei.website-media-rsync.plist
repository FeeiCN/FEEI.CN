<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.feei.website-media-rsync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/feei/Projects/my-website/scripts/media-rsync.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/feei/Projects/my-website</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/website-media-rsync.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/website-media-rsync.err.log</string>
</dict>
</plist>
