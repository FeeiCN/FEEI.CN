#!/usr/bin/env python3
import fcntl
import json
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

NAME_RE = re.compile(r'^(?P<yy>\d{2})(?P<mm>\d{2})(?P<dd>\d{2})(?P<hh>\d{2})(?P<mi>\d{2})(?P<ss>\d{2})(?:-\d+)?\.(?:webp|mp4)$', re.I)
LOCK = Path('/run/iphone-photo-index.lock')

def dimensions(path):
    if path.suffix.lower() == '.webp':
        cmd = ['/usr/bin/webpinfo', str(path)]
    else:
        cmd = ['/usr/bin/ffprobe', '-v', 'error', '-select_streams', 'v:0', '-show_entries', 'stream=width,height', '-of', 'csv=p=0', str(path)]
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    if path.suffix.lower() == '.mp4':
        values = result.stdout.strip().split(',')
        if len(values) == 2:
            return int(values[0]), int(values[1])
    width = height = None
    for line in result.stdout.splitlines():
        line = line.strip()
        if line.startswith('Width:'): width = int(line.split(':', 1)[1])
        if line.startswith('Height:'): height = int(line.split(':', 1)[1])
    if width is None or height is None: raise ValueError(path)
    return width, height

def write_index(month_dir):
    year, month = month_dir.parent.name, month_dir.name
    groups = {}
    for path in sorted(month_dir.iterdir(), key=lambda p: p.name):
        if not path.is_file() or path.suffix.lower() not in ('.webp', '.mp4'): continue
        match = NAME_RE.match(path.name)
        if not match: continue
        date = '20{}-{}-{}'.format(match['yy'], match['mm'], match['dd'])
        if date[:7] != '{}-{}'.format(year, month): continue
        try: width, height = dimensions(path)
        except (OSError, ValueError, subprocess.CalledProcessError): width = height = None
        item = {'name': path.name, 'type': 'video' if path.suffix.lower() == '.mp4' else 'photo', 'url': '/media/{}/{}/{}'.format(year, month, path.name), 'taken_at': '{}-{}-{}T{}:{}:{}+08:00'.format(date[:4], date[5:7], date[8:10], match['hh'], match['mi'], match['ss']), 'width': width, 'height': height}
        groups.setdefault(date, []).append(item)
    days = {date: {'count': len(items), 'files': items} for date, items in sorted(groups.items())}
    payload = {'schema_version': 1, 'month': '{}-{}'.format(year, month), 'generated_at': datetime.now(timezone.utc).isoformat(), 'days': days}
    fd, temp_name = tempfile.mkstemp(prefix='.index.', suffix='.json', dir=month_dir)
    try:
        with open(fd, 'w', encoding='utf-8') as handle: json.dump(payload, handle, ensure_ascii=False, indent=2); handle.write('\n')
        Path(temp_name).chmod(0o644); Path(temp_name).replace(month_dir / 'index.json')
    finally: Path(temp_name).unlink(missing_ok=True)

def main():
    root = Path(sys.argv[1] if len(sys.argv) > 1 else '/data/wufeifei-assets/media/2026')
    dirs = [Path(sys.argv[2])] if len(sys.argv) > 2 else sorted(p for p in root.iterdir() if p.is_dir() and p.name.isdigit())
    with LOCK.open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for directory in dirs:
            if directory.is_dir(): write_index(directory)

if __name__ == '__main__': main()
