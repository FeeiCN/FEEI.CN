    c:document <https://feei.cn/knowledge/compliance/source:gb-t-37933-2019> ;
    c:line 1140 ;
    c:quote "| 辐射发射 | 整机 | GB 4824—2013、GB/T 9254—2008 | 30 MHz～1 GHz | A 类 |" .

