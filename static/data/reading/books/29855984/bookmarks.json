{
  "fetchedAt": "2026-06-11 13:23:26",
  "synckey": 1745918125,
  "updated": [
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_155_2584-2616",
      "createTime": 1745553448,
      "range": "2584-2616",
      "markText": "夫英雄者，胸怀大志，腹有良谋，有包藏宇宙之机，吞吐天地之志者也。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 155
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_243_2457-2473",
      "createTime": 1704301236,
      "range": "2745-2761",
      "markText": "大丈夫立功名，取富贵，正在今日！",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 268
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_236_5341-5355",
      "createTime": 1704301205,
      "range": "5341-5355",
      "markText": "大丈夫舍身报国，虽万死无恨。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 236
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_198_3844-3857",
      "createTime": 1704301171,
      "range": "3844-3857",
      "markText": "大丈夫既领重任，除死方休。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 198
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_195_4480-4499",
      "createTime": 1704301151,
      "range": "4480-4499",
      "markText": "大丈夫处世，当努力建功立业，著鞭在先。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 195
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_187_5314-5344",
      "createTime": 1704301127,
      "range": "5314-5344",
      "markText": "大丈夫生于乱世，当带三尺剑立不世之功，今所志未遂，奈何死乎！",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 187
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_185_4003-4042",
      "createTime": 1704301107,
      "range": "4003-4042",
      "markText": "大丈夫既食君禄，当死于战场，以马革裹尸还，幸也！岂可为我一人，而废国家大事乎？",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 185
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_185_1282-1295",
      "createTime": 1704301090,
      "range": "1282-1295",
      "markText": "大丈夫一言既出，何悔之有！",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 185
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_181_2735-2750",
      "createTime": 1704301067,
      "range": "2735-2750",
      "markText": "大丈夫既遇明主，自当倾心相投。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 181
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_181_610-632",
      "createTime": 1704301055,
      "range": "610-632",
      "markText": "大丈夫处世，不能立功建业，不几与草木同腐乎！",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 181
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_179_5551-5590",
      "createTime": 1704301035,
      "range": "5743-5782",
      "markText": "大丈夫处世，遇知己之主，外托君臣之义，内结骨肉之恩，言必行，计必从，祸福共之。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 261
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_172_1783-1802",
      "createTime": 1704300998,
      "range": "1783-1802",
      "markText": "大丈夫抱经世奇才，岂可空老于林泉之下？",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 172
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_165_1052-1084",
      "createTime": 1704300980,
      "range": "1052-1084",
      "markText": "大丈夫生于天地间，不识其主而事之，是无智也！今日受死，夫何足惜！",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 165
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_162_3764-3783",
      "createTime": 1704300956,
      "range": "3764-3783",
      "markText": "忠臣宁死而不辱。大丈夫岂有事二主之理！",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 162
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_148_6263-6273",
      "createTime": 1704300937,
      "range": "6263-6273",
      "markText": "此非大丈夫之所为也。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 148
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_143_1958-1976",
      "createTime": 1704300919,
      "range": "1958-1976",
      "markText": "大丈夫生居天地间，岂能郁郁久居人下！",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 143
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_141_2703-2721",
      "createTime": 1704300904,
      "range": "2703-2721",
      "markText": "大丈夫愿临阵斗死，岂可入墙而望活乎！",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 141
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_135_3938-3953",
      "createTime": 1704300853,
      "range": "3938-3953",
      "markText": "大丈夫不与国家出力，何故长叹？",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 135
    },
    {
      "bookId": "29855984",
      "bookmarkId": "29855984_211_5557-5624",
      "createTime": 1704300802,
      "range": "5654-5721",
      "markText": "吾乃解良一武夫，蒙吾主以手足相待，安肯背义投敌国乎？城若破，有死而已。玉可碎而不可改其白，竹可焚而不可毁其节：身虽殒，名可垂于竹帛也。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 264
    }
  ],
