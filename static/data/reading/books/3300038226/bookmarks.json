{
  "fetchedAt": "2026-06-11 13:24:37",
  "synckey": 1745505536,
  "updated": [
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_320_407-450",
      "createTime": 1745505536,
      "range": "407-450",
      "markText": "深不怕风摇动，树正何愁月影斜。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 320
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_318_407-446",
      "createTime": 1745505509,
      "range": "407-446",
      "markText": "乱思良将，家贫思贤妻。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 318
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_315_407-472",
      "createTime": 1745505481,
      "range": "407-472",
      "markText": "有正条，民有私约。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 315
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_308_406-446",
      "createTime": 1745505423,
      "range": "406-446",
      "markText": "国清才子贵，家富小儿骄。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 308
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_307_406-444",
      "createTime": 1745505408,
      "range": "406-444",
      "markText": "养军千日，用在一时。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 307
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_297_406-446",
      "createTime": 1745505354,
      "range": "406-446",
      "markText": "富从升合起，贫因不算来。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 297
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_293_406-454",
      "createTime": 1745505321,
      "range": "406-454",
      "markText": "良田万顷，日食一升。大厦千间，夜眠八尺。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 293
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_292_406-444",
      "createTime": 1745505309,
      "range": "406-444",
      "markText": "人生一世，如驹过隙。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 292
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_288_406-446",
      "createTime": 1745505281,
      "range": "406-446",
      "markText": "万事皆先定，浮生空自忙。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 288
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_283_406-448",
      "createTime": 1745505227,
      "range": "406-448",
      "markText": "凡人不可面相，海水不可斗量。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 283
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_282_406-450",
      "createTime": 1745505216,
      "range": "406-450",
      "markText": "秋至满山多秀色，春来无处不花香。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 282
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_278_406-444",
      "createTime": 1745505182,
      "range": "406-444",
      "markText": "人贫志短，马瘦毛长。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 278
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_271_406-450",
      "createTime": 1745505110,
      "range": "406-450",
      "markText": "爽口食多偏作病，快心事过恐生殃。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 271
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_266_406-444",
      "createTime": 1745505076,
      "range": "406-444",
      "markText": "顺天者存，逆天者亡。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 266
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_265_406-450",
      "createTime": 1745505064,
      "range": "406-450",
      "markText": "忠言逆耳利于行，良药苦口利于病。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 265
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_259_406-450",
      "createTime": 1745505022,
      "range": "406-450",
      "markText": "屋漏更遭连夜雨，行船又被打头风。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 259
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_257_406-478",
      "createTime": 1745505000,
      "range": "406-478",
      "markText": "乍富不知新受用，乍贫难改旧家风。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 257
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_255_406-446",
      "createTime": 1745504979,
      "range": "406-446",
      "markText": "人无千日好，花无百日红。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 255
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_242_406-446",
      "createTime": 1745504883,
      "range": "406-446",
      "markText": "灭却心头火，剔起佛前灯。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 242
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_233_406-443",
      "createTime": 1745485361,
      "range": "406-443",
      "markText": "但行好事，莫问前程",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 233
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_232_406-454",
      "createTime": 1745485342,
      "range": "406-454",
      "markText": "与人不和，劝人养鹅。与人不睦，劝人架屋。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 232
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_227_406-446",
      "createTime": 1745485294,
      "range": "406-446",
      "markText": "点石化为金，人心犹未足。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 227
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_225_407-446",
      "createTime": 1745485271,
      "range": "407-446",
      "markText": "俭入奢易，从奢入俭难。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 225
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_222_406-446",
      "createTime": 1745485240,
      "range": "406-446",
      "markText": "莫将容易得，便作等闲看。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 222
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_217_406-474",
      "createTime": 1745485182,
      "range": "406-474",
      "markText": "妻贤夫祸少，子孝父心宽。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 217
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_213_406-444",
      "createTime": 1745473545,
      "range": "406-444",
      "markText": "为善最乐，为恶难逃。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 213
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_211_406-450",
      "createTime": 1745473516,
      "range": "406-450",
      "markText": "世上万般皆下品，思量惟有读书高。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 211
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_210_406-474",
      "createTime": 1745473506,
      "range": "406-474",
      "markText": "黄金未为贵，安乐值钱多。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 210
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_209_406-448",
      "createTime": 1745473486,
      "range": "406-448",
      "markText": "天时不如地利，地利不如人和。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 209
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_208_406-444",
      "createTime": 1745473476,
      "range": "406-444",
      "markText": "光阴似箭，日月如梭。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 208
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_206_406-450",
      "createTime": 1745473448,
      "range": "406-450",
      "markText": "强中更有强中手，恶人须用恶人磨。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 206
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_205_406-478",
      "createTime": 1745473439,
      "range": "406-478",
      "markText": "入山不怕伤人虎，只怕人情两面刀。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 205
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_204_406-450",
      "createTime": 1745473426,
      "range": "406-450",
      "markText": "知事少时烦恼少，识人多处是非多。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 204
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_202_406-446",
      "createTime": 1745473348,
      "range": "406-446",
      "markText": "不因渔父引，怎得见波涛。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 202
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_200_406-450",
      "createTime": 1745473320,
      "range": "406-450",
      "markText": "遇饮酒时须饮酒，得高歌处且高歌。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 200
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_192_406-482",
      "createTime": 1745473219,
      "range": "406-482",
      "markText": "君子爱财，取之有道。贞妇爱色，纳之以礼。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 192
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_188_406-444",
      "createTime": 1745473161,
      "range": "406-444",
      "markText": "死生有命，富贵在天。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 188
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_186_406-446",
      "createTime": 1745472996,
      "range": "406-446",
      "markText": "富人思来年，贫人思眼前。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 186
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_185_406-478",
      "createTime": 1745472982,
      "range": "406-478",
      "markText": "将相顶头堪走马，公侯肚里好撑船。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 185
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_184_406-446",
      "createTime": 1745472968,
      "range": "406-446",
      "markText": "未晚先投宿，鸡鸣早看天。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 184
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_183_406-450",
      "createTime": 1745472845,
      "range": "406-450",
      "markText": "枯木逢春犹再发，人无两度再少年。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 183
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_180_406-460",
      "createTime": 1745472811,
      "range": "406-460",
      "markText": "一日夫妻，百世姻缘。百世修来同船渡，千世修来共枕眠。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 180
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_170_406-461",
      "createTime": 1745472660,
      "range": "406-461",
      "markText": "三人同行，必有我师焉；择其善者而从之，其不善者而改之。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 170
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_168_406-450",
      "createTime": 1745472637,
      "range": "406-450",
      "markText": "道吾好者是吾贼，道吾恶者是吾师。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 168
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_163_406-474",
      "createTime": 1745472430,
      "range": "406-474",
      "markText": "官清书吏瘦，神灵庙祝肥。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 163
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_157_406-450",
      "createTime": 1745419663,
      "range": "406-450",
      "markText": "酒债寻常行处有，人生七十古来稀。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 157
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_156_407-450",
      "createTime": 1745419635,
      "range": "407-450",
      "markText": "载寒窗无人问，一举成名天下知。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 156
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_154_406-450",
      "createTime": 1745419598,
      "range": "406-450",
      "markText": "龙游浅水遭虾戏，虎落平洋被犬欺。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 154
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_147_406-444",
      "createTime": 1745419516,
      "range": "406-444",
      "markText": "送君千里，终须一别。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 147
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_143_406-444",
      "createTime": 1745414742,
      "range": "406-444",
      "markText": "得宠思辱，安居虑危。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 143
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_142_406-450",
      "createTime": 1745414724,
      "range": "406-450",
      "markText": "黄河尚有澄清日，岂可人无得运时。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 142
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_140_406-448",
      "createTime": 1745414684,
      "range": "406-448",
      "markText": "人无横财不富，马无夜草不肥。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 140
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_138_406-466",
      "createTime": 1745414665,
      "range": "406-466",
      "markText": "父母恩深终有别，夫妻义重也分离。人生似鸟同林宿，大限来时各自飞。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 138
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_133_406-446",
      "createTime": 1745414588,
      "range": "406-446",
      "markText": "休别有鱼处，莫恋浅滩头。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 133
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_121_406-450",
      "createTime": 1745413633,
      "range": "406-450",
      "markText": "今朝有酒今朝醉，明日愁来明日忧。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 121
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_120_406-446",
      "createTime": 1745413622,
      "range": "406-446",
      "markText": "人生不满百，常怀千岁忧。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 120
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_119_406-450",
      "createTime": 1745413611,
      "range": "406-450",
      "markText": "儿孙自有儿孙福，莫为儿孙作马牛。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 119
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_115_406-446",
      "createTime": 1745413553,
      "range": "406-446",
      "markText": "惧法朝朝乐，欺公日日忧。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 115
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_113_406-420",
      "createTime": 1745413518,
      "range": "406-420",
      "markText": "忍得一时之气，免得百日之忧。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 113
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_87_405-445",
      "createTime": 1745386863,
      "range": "405-445",
      "markText": "结交须胜己，似我不如无。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 87
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_86_914-925",
      "createTime": 1745386822,
      "range": "914-925",
      "markText": "谈笑有鸿儒，往来无白丁",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 86
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_86_405-457",
      "createTime": 1745386806,
      "range": "405-457",
      "markText": "道院迎仙客，书堂隐相儒。庭栽栖凤竹，池养化龙鱼。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 86
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_85_405-421",
      "createTime": 1745386727,
      "range": "405-421",
      "markText": "命里有时终须有，命里无时莫强求。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 85
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_84_405-477",
      "createTime": 1745386714,
      "range": "405-477",
      "markText": "竹篱茅舍风光好，道院僧堂总不如。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 84
    },
    {
      "bookId": "3300038226",
      "bookmarkId": "3300038226_77_405-447",
      "createTime": 1745386524,
      "range": "405-447",
      "markText": "水至清则无鱼，人太紧则无智。",
      "colorStyle": 0,
      "type": 1,
      "chapterUid": 77
    }
  ],
  "removed": [],
