  "items": [
    {
      "bookId": "26796434",
      "userVid": 309702511,
      "bookmarkId": "26796434_227_424-463",
      "chapterUid": 227,
      "range": "424-463",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "天薄我福，吾厚吾德以迓之；天劳我形，吾逸吾心以补之；天厄我遇，吾亨吾道以通之。",
      "totalCount": 252
    },
    {
      "bookId": "26796434",
      "userVid": 267664407,
      "bookmarkId": "26796434_226_424-460",
      "chapterUid": 226,
      "range": "424-460",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "使人有面前之誉，不若使人无背后之毁；使人有乍交之欢，不若使人无久处之厌。",
      "totalCount": 128
    },
    {
      "bookId": "26796434",
      "userVid": 309702511,
      "bookmarkId": "26796434_221_1465-1485",
      "chapterUid": 221,
      "range": "1465-1485",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "读未见书，如得良友；见已读书，如逢故人。",
      "totalCount": 112
    },
    {
      "bookId": "26796434",
      "userVid": 371902290,
      "bookmarkId": "26796434_229_422-451",
      "chapterUid": 229,
      "range": "422-451",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "一念之善，吉神随之；一念之恶，厉鬼随之。知此可以役使鬼神。",
      "totalCount": 108
    },
    {
      "bookId": "26796434",
      "userVid": 337921097,
      "bookmarkId": "26796434_232_422-436",
      "chapterUid": 232,
      "range": "422-436",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "谈空反被空迷，耽静多为静缚。",
      "totalCount": 102
    },
    {
      "bookId": "26796434",
      "userVid": 25808885,
      "bookmarkId": "26796434_225_422-438",
      "chapterUid": 225,
      "range": "422-438",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "人生待足何时足，未老得闲始是闲。",
      "totalCount": 100
    },
    {
      "bookId": "26796434",
      "userVid": 237912884,
      "bookmarkId": "26796434_375_428-452",
      "chapterUid": 375,
      "range": "428-452",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "闭门阅佛书，开门接佳客，出门寻山水，此人生三乐。",
      "totalCount": 90
    },
    {
      "bookId": "26796434",
      "userVid": 352857333,
      "bookmarkId": "26796434_244_424-479",
      "chapterUid": 244,
      "range": "424-479",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "好丑心太明，则物不契；贤愚心太明，则人不亲。须是内精明而外浑厚，使好丑两得其平，贤愚共受其益，才是生成的德量。",
      "totalCount": 85
    },
    {
      "bookId": "26796434",
      "userVid": 333880199,
      "bookmarkId": "26796434_224_424-452",
      "chapterUid": 224,
      "range": "424-452",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "淡泊之守，须从秾艳场中试来；镇定之操，还向纷纭境上勘过。",
      "totalCount": 84
    },
    {
      "bookId": "26796434",
      "userVid": 233778098,
      "bookmarkId": "26796434_231_428-460",
      "chapterUid": 231,
      "range": "428-460",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "云烟影里见真身，始悟形骸为桎梏；禽鸟声中闻自性，方知情识是戈矛。",
      "totalCount": 78
    },
    {
      "bookId": "26796434",
      "userVid": 239658397,
      "bookmarkId": "26796434_266_424-448",
      "chapterUid": 266,
      "range": "424-448",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "有誉于前，不若无毁于后；有乐于身，不若无忧于心。",
      "totalCount": 70
    },
    {
      "bookId": "26796434",
      "userVid": 210476565,
      "bookmarkId": "26796434_248_424-447",
      "chapterUid": 248,
      "range": "424-447",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "居不必无恶邻，会不必无损友，惟在自持者两得之。",
      "totalCount": 64
    },
    {
      "bookId": "26796434",
      "userVid": 337921097,
      "bookmarkId": "26796434_233_422-438",
      "chapterUid": 233,
      "range": "422-438",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "伏久者，飞必高；开先者，谢独早。",
      "totalCount": 60
    },
    {
      "bookId": "26796434",
      "userVid": 21167693,
      "bookmarkId": "26796434_426_422-448",
      "chapterUid": 426,
      "range": "422-448",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "有书癖而无剪裁，徒号书橱；惟名饮而少蕴藉，终非名饮。",
      "totalCount": 60
    },
    {
      "bookId": "26796434",
      "userVid": 371902290,
      "bookmarkId": "26796434_236_428-498",
      "chapterUid": 236,
      "range": "428-498",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "山栖是胜事，稍一萦恋，则亦市朝；书画赏鉴是雅事，稍一贪痴，则亦商贾；诗酒是乐事，稍一徇人，则亦地狱；好客是豁达事，稍一为俗子所挠，则亦苦海。",
      "totalCount": 56
    },
    {
      "bookId": "26796434",
      "userVid": 207721474,
      "bookmarkId": "26796434_221_4400-4464",
      "chapterUid": 221,
      "range": "4400-4464",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "最后借此付梓之际，特向业已作古的训诫学家和传承中华古典文化精髓的译注者以及为本丛书指点迷津的出版社相关人士，谨致以最深挚的谢意。",
      "totalCount": 54
    },
    {
      "bookId": "26796434",
      "userVid": 210476565,
      "bookmarkId": "26796434_223_847-896",
      "chapterUid": 223,
      "range": "847-896",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "今世之虚名浮利却令世人无一日清醒，不是沉迷于官场便是浮沉于商海，在这酩酊大醉之中有几人能忘却欲念？",
      "totalCount": 54
    },
    {
      "bookId": "26796434",
      "userVid": 239658397,
      "bookmarkId": "26796434_251_422-442",
      "chapterUid": 251,
      "range": "422-442",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "先淡后浓，先疏后亲，先远后近，交友道也。",
      "totalCount": 51
    },
    {
      "bookId": "26796434",
      "userVid": 239658397,
      "bookmarkId": "26796434_223_424-484",
      "chapterUid": 223,
      "range": "424-484",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "食中山之酒，一醉千日。今之昏昏逐逐，无一日不醉。趋名者醉于朝，趋利者醉于野，豪者醉于声色车马。安得一服清凉散，人人解醒？",
      "totalCount": 48
    },
    {
      "bookId": "26796434",
      "userVid": 438922957,
      "bookmarkId": "26796434_225_655-695",
      "chapterUid": 225,
      "range": "655-695",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "世人总是在年轻时闷闷不乐，但到老时才知那是因为被名所累、为利所扰，不能自拔罢了。",
      "totalCount": 48
    }
  ],
