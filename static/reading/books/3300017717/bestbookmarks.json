      "userVid": 288832302,
      "bookmarkId": "3300017717_8_11668-11693",
      "chapterUid": 8,
      "range": "11668-11693",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "维根饮食是指完全只吃植物，不吃肉类、乳制品及鸡蛋。",
      "totalCount": 132
    },
    {
      "bookId": "3300017717",
