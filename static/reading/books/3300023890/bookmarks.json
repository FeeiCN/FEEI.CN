      "createTime": 1765500865
    },
    {
      "bookId": "3300023890",
      "chapterIdx": 46,
      "bookmarkId": "3300023890_46_538-566",
      "range": "538-566",
      "markText": "想要在竞争中取得好成绩，关键的一点就是做到既健壮又灵活。",
      "colorStyle": 5,
      "type": 1,
      "chapterUid": 46,
