    },
    {
      "bookId": "3300045215",
      "chapterIdx": 7,
      "bookmarkId": "3300045215_7_2149-2169",
      "range": "2149-2169",
      "markText": "学习有四个层次：听过、知道、理解和能讲。",
      "colorStyle": 5,
      "type": 1,
      "chapterUid": 7,
      "createTime": 1766635901
    },
    {
      "bookId": "3300045215",
      "chapterIdx": 7,
      "bookmarkId": "3300045215_7_2369-2454",
      "range": "2369-2454",
      "markText": "人们习惯用复杂的词汇来掩饰自己不明白的事情。要想彻底地掌握一个知识点，最好的方法就是用自己的话通俗而有条理地讲一次。这种方法被称为费曼学习法，也被誉为史上最强的学习方法。",
      "colorStyle": 5,
      "type": 1,
      "chapterUid": 7,
      "createTime": 1766635763
    }
