      "chapterUid": 30,
      "range": "14842-14874",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "永远保持对学习的兴趣，多学习，多思考，多去请教别人，贵在坚持……",
      "totalCount": 1456
    },
    {
      "bookId": "41101412",
