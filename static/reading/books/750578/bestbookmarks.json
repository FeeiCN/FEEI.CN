      "bookmarkId": "750578_32_3032-3050",
      "chapterUid": 32,
      "range": "3032-3050",
      "simplifiedRange": "",
      "traditionalRange": "",
      "markText": "切记：健身要循序渐进，不要急于求成。",
      "totalCount": 928
    },
    {
